OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: MCP server URL (needed for --mcp mode)
# MCP_SERVER_URL_OVERRIDE=http://localhost:8787/mcp

# Optional: Override default rate limits (requests per minute)
# OPENAI_RATE_LIMIT_RPM=500
# ANTHROPIC_RATE_LIMIT_RPM=5
# GOOGLE_RATE_LIMIT_RPM=15

# Optional: Push results to Braintrust for dashboards and experiment comparison
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=openfort-evals
