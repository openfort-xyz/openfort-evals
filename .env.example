OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
V0_API_KEY=

# Optional: Override MCP server URL (defaults to https://mcp.openfort.io/sse)
# MCP_SERVER_URL_OVERRIDE=http://localhost:8787/mcp

# Rate limiting configuration (requests per minute)
# Adjust these values based on your API tier limits
# OpenAI defaults: Usage tier 1 = 500 RPM
# Anthropic defaults: Free tier = 5 RPM, Build tier = 50 RPM, Scale tier = 1000 RPM
# Google defaults: 60 RPM
# v0 defaults: 10 per day in Free Tier, ?
OPENAI_RATE_LIMIT_RPM=500
ANTHROPIC_RATE_LIMIT_RPM=5
GOOGLE_RATE_LIMIT_RPM=60
VERCEL_RATE_LIMIT_RPM=10
